# Copy this file to .env and fill in the values. NEVER commit .env to GitHub.
SECRET_KEY=replace-with-a-long-random-string
# Optional: enables the AI Study Assistant (the rest of the site works without it)
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Optional: creates an admin account automatically on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional: production database (defaults to local SQLite)
DATABASE_URL=
